<%- include("partials/head") %>
<div class="card w-full max-w-md bg-base-100 shadow-xl">
  <div class="card-body gap-4">
    <div>
      <h1 class="text-2xl font-bold">Entrar</h1>
      <p class="text-sm text-base-content/70">Acesse sua conta para assinar documentos.</p>
    </div>

    <% if (error) { %>
      <div role="alert" class="alert alert-error alert-soft"><span><%= error %></span></div>
    <% } %>

    <form method="post" action="/login" class="flex flex-col gap-3" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <fieldset class="fieldset">
        <legend class="fieldset-legend">E-mail</legend>
        <input type="email" name="email" value="<%= values.email ?? '' %>" autocomplete="email" required
               class="input w-full" placeholder="voce@empresa.com">
      </fieldset>

      <fieldset class="fieldset">
        <legend class="fieldset-legend">Senha</legend>
        <input type="password" name="password" autocomplete="current-password" required
               class="input w-full" placeholder="Sua senha">
      </fieldset>

      <button type="submit" class="btn btn-primary w-full mt-2">Entrar</button>
    </form>

    <p class="text-center text-sm">Ainda não tem conta? <a href="/register" class="link link-primary">Criar conta</a></p>
  </div>
</div>
<%- include("partials/foot") %>
